<!DOCTYPE html>
@using LaundryApp.Services
@inject Microsoft.Extensions.Options.IOptions<ServiceAreaOptions> ServiceAreaOptions
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#02081f" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="LUMA" />
    <link rel="manifest" href="~/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="~/lumalogo.png" />
    <title>@ViewData["Title"] - Luma</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/LaundryApp.styles.css" asp-append-version="true" />
</head>
<body class="app-shell">
    <header>
        <nav class="navbar navbar-expand-lg landing-nav mb-3">
            <div class="container landing-nav-shell">
                <a class="navbar-brand landing-brand" asp-area="" asp-controller="Home" asp-action="Index">LUMA</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse" id="mainNavbar">
                    @{
                        var serviceArea = ServiceAreaOptions.Value;
                        var serviceLocations = serviceArea.AllowedCities
                            .Where(c => !string.IsNullOrWhiteSpace(c))
                            .Select(c => c.Trim())
                            .Distinct(StringComparer.OrdinalIgnoreCase)
                            .OrderBy(c => c)
                            .ToList();
                        var serviceState = string.IsNullOrWhiteSpace(serviceArea.AllowedState)
                            ? "FL"
                            : serviceArea.AllowedState.Trim().ToUpperInvariant();
                        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
                        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
                        var isHomePage = string.Equals(ViewContext.RouteData.Values["controller"]?.ToString(), "Home", StringComparison.OrdinalIgnoreCase)
                            && string.Equals(ViewContext.RouteData.Values["action"]?.ToString(), "Index", StringComparison.OrdinalIgnoreCase);
                        var isHowItWorksPage = string.Equals(currentController, "Home", StringComparison.OrdinalIgnoreCase)
                            && string.Equals(currentAction, "HowItWorks", StringComparison.OrdinalIgnoreCase);
                            var isFirstOrderPage = string.Equals(currentController, "Home", StringComparison.OrdinalIgnoreCase)
                                && string.Equals(currentAction, "FirstOrder", StringComparison.OrdinalIgnoreCase);
                        var isPricingPage = string.Equals(currentController, "Home", StringComparison.OrdinalIgnoreCase)
                            && string.Equals(currentAction, "Pricing", StringComparison.OrdinalIgnoreCase);
                        var isLocationsPage = string.Equals(currentController, "Home", StringComparison.OrdinalIgnoreCase)
                            && string.Equals(currentAction, "Locations", StringComparison.OrdinalIgnoreCase);
                    }
                    <ul class="navbar-nav mx-auto landing-links">
                            <li class="nav-item"><a class="nav-link @(isHomePage ? "active" : "")" href="/">Home</a></li>
                            <li class="nav-item"><a class="nav-link" href="/#features">Features</a></li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle @(isHowItWorksPage || isFirstOrderPage ? "active" : "")" href="#" id="howItWorksDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    How It Works
                                </a>
                                <ul class="dropdown-menu landing-dropdown-menu" aria-labelledby="howItWorksDropdown">
                                    <li><a class="dropdown-item @(isHowItWorksPage ? "active" : "")" asp-area="" asp-controller="Home" asp-action="HowItWorks">Overview</a></li>
                                    <li><a class="dropdown-item @(isFirstOrderPage ? "active" : "")" asp-area="" asp-controller="Home" asp-action="FirstOrder">First Order Guide</a></li>
                                </ul>
                            </li>
                            <li class="nav-item"><a class="nav-link @(isPricingPage ? "active" : "")" asp-area="" asp-controller="Home" asp-action="Pricing">Pricing</a></li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle @(isLocationsPage ? "active" : "")" href="#" id="locationsDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Locations
                                </a>
                                <ul class="dropdown-menu landing-dropdown-menu" aria-labelledby="locationsDropdown">
                                    <li><a class="dropdown-item" href="/locations/florida">Florida Service Area</a></li>
                                    @if (serviceLocations.Count > 0)
                                    {
                                        <li><hr class="dropdown-divider"></li>
                                        @foreach (var location in serviceLocations)
                                        {
                                            <li>
                                                <a class="dropdown-item" href="/locations/florida?city=@Uri.EscapeDataString(location)#service">@location, @serviceState</a>
                                            </li>
                                        }
                                    }
                                </ul>
                            </li>
                            <li class="nav-item"><a class="nav-link" href="/#faq">FAQ</a></li>
                    </ul>
                    <div class="d-flex align-items-center gap-3">
                        @if (isHomePage)
                        {
                            <a class="landing-contact-box" href="mailto:support@luma-laundry.app">✉ CONTACT</a>
                        }
                        @if (User?.Identity?.IsAuthenticated ?? false)
                        {
                            <div class="dropdown">
                                <a class="landing-signin dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">@User.Identity?.Name</a>
                                <ul class="dropdown-menu dropdown-menu-end landing-dropdown-menu">
                                    <li><a class="dropdown-item" asp-area="" asp-controller="Home" asp-action="Dashboard">Dashboard</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-controller="Orders" asp-action="Schedule">Schedule</a></li>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <li><a class="dropdown-item" asp-area="" asp-controller="Admin" asp-action="Index">Admin</a></li>
                                    }
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form method="post" action="/Account/Logout" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item">Logout</button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                            <a class="btn landing-cta-btn" asp-area="" asp-controller="Orders" asp-action="Schedule">Schedule Pickup</a>
                        }
                        else
                        {
                            <a class="landing-signin" asp-area="" asp-controller="Account" asp-action="Login">Sign in</a>
                            <a class="btn landing-cta-btn" asp-area="" asp-controller="Account" asp-action="Register">Schedule Pickup</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="app-footer pt-4 text-light">
        <div class="container-fluid px-4 px-lg-5">
            <div class="app-footer-main py-4 py-lg-5">
                <div class="row g-4 align-items-start">
                    <div class="col-12 col-lg-6">
                        <img src="~/luma-logo.svg" alt="LUMA" class="app-footer-logo" />
                        <p class="mb-2 mt-4 app-footer-contact">
                            ✉ <a href="mailto:support@luma-laundry.app" class="app-footer-link-strong">support@luma-laundry.app</a>
                        </p>
                        <p class="mb-0 app-footer-contact">
                            ☎ <a href="tel:+19107534859" class="app-footer-link-strong">(910) 753-4859</a>
                        </p>
                    </div>
                    <div class="col-12 col-lg-6">
                        <div class="row g-4">
                            <div class="col-6 col-md-4">
                                <h3 class="app-footer-heading">Company</h3>
                                <ul class="list-unstyled app-footer-list mb-0">
                                    <li><a href="/#home">Home</a></li>
                                    <li><a href="/#features">Services</a></li>
                                    <li><a asp-area="" asp-controller="Home" asp-action="HowItWorks">Work</a></li>
                                    <li><a href="mailto:support@luma-laundry.app">Contact</a></li>
                                </ul>
                            </div>
                            <div class="col-6 col-md-4">
                                <h3 class="app-footer-heading">Legal</h3>
                                <ul class="list-unstyled app-footer-list mb-0">
                                    <li><a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy Policy</a></li>
                                    <li><a asp-area="" asp-controller="Account" asp-action="Terms">Terms of Service</a></li>
                                </ul>
                            </div>
                            <div class="col-6 col-md-4">
                                <h3 class="app-footer-heading">Connect</h3>
                                <ul class="list-unstyled app-footer-list mb-0">
                                    <li><a href="https://twitter.com" target="_blank" rel="noopener noreferrer">Twitter</a></li>
                                    <li><a href="https://linkedin.com" target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
                                    <li><a href="https://github.com" target="_blank" rel="noopener noreferrer">GitHub</a></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <p class="app-footer-copy mb-0 py-3 text-center">
                &copy; @DateTime.UtcNow.Year LUMA. All rights reserved.
            </p>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/lenis/lenis.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', function () {
                navigator.serviceWorker.register('/service-worker.js');
            });
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

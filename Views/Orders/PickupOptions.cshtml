@{
    ViewData["Title"] = "Pickup Options";
}

<section class="schedule-hero mb-4">
    <div class="schedule-hero__inner">
        <h1 class="mb-2">Pickup Options</h1>
        <p class="mb-0">Choose your bag counts and whether this order is same-day delivery before scheduling your pickup time.</p>
    </div>
</section>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        {
            <div>@err.ErrorMessage</div>
        }
    </div>
}

<form method="post" class="card schedule-card">
    @Html.AntiForgeryToken()
    <div class="card-body">
        <h5 class="mb-3">Wash & Fold</h5>

        <div class="row g-3 mb-4">
            <div class="col-md-6 col-lg-4">
                <label class="form-label" for="standardLaundryBagCount">Standard Laundry Bag(s)</label>
                <input class="form-control pickup-qty-input" type="number" min="0" id="standardLaundryBagCount" name="standardLaundryBagCount" value="0" required />
                <div class="form-text">Wash & Fold pricing bags are labeled as Standard Laundry Bag.</div>
            </div>
        </div>

        <h5 class="mb-3">Large Bedding Items</h5>
        <div class="row g-3 mb-4">
            <div class="col-md-6 col-lg-3">
                <label class="form-label" for="comforterKingQty">Comforter (King)</label>
                <input class="form-control pickup-qty-input" type="number" min="0" id="comforterKingQty" name="comforterKingQty" value="0" />
            </div>
            <div class="col-md-6 col-lg-3">
                <label class="form-label" for="comforterQueenQty">Comforter (Queen)</label>
                <input class="form-control pickup-qty-input" type="number" min="0" id="comforterQueenQty" name="comforterQueenQty" value="0" />
            </div>
            <div class="col-md-6 col-lg-3">
                <label class="form-label" for="comforterFullQty">Comforter (Full)</label>
                <input class="form-control pickup-qty-input" type="number" min="0" id="comforterFullQty" name="comforterFullQty" value="0" />
            </div>
            <div class="col-md-6 col-lg-3">
                <label class="form-label" for="comforterTwinQty">Comforter (Twin)</label>
                <input class="form-control pickup-qty-input" type="number" min="0" id="comforterTwinQty" name="comforterTwinQty" value="0" />
            </div>
        </div>

        <h5 class="mb-3">Household Items</h5>
        <div class="row g-3">
            <div class="col-md-6 col-lg-3">
                <label class="form-label" for="bedspreadQty">Bedspread</label>
                <input class="form-control pickup-qty-input" type="number" min="0" id="bedspreadQty" name="bedspreadQty" value="0" />
            </div>
            <div class="col-md-6 col-lg-3">
                <label class="form-label" for="cushionSlipCoverQty">Cushion Slip Cover</label>
                <input class="form-control pickup-qty-input" type="number" min="0" id="cushionSlipCoverQty" name="cushionSlipCoverQty" value="0" />
            </div>
            <div class="col-md-6 col-lg-3">
                <label class="form-label" for="chairSlipCoverQty">Chair Slip Cover</label>
                <input class="form-control pickup-qty-input" type="number" min="0" id="chairSlipCoverQty" name="chairSlipCoverQty" value="0" />
            </div>
            <div class="col-md-6 col-lg-3">
                <label class="form-label" for="sofaSlipCoverQty">Sofa Slip Cover</label>
                <input class="form-control pickup-qty-input" type="number" min="0" id="sofaSlipCoverQty" name="sofaSlipCoverQty" value="0" />
            </div>
            <div class="col-md-6 col-lg-3">
                <label class="form-label" for="blanketQty">Blanket</label>
                <input class="form-control pickup-qty-input" type="number" min="0" id="blanketQty" name="blanketQty" value="0" />
            </div>
            <div class="col-md-6 col-lg-3">
                <label class="form-label" for="pillowShamQty">Pillow Sham</label>
                <input class="form-control pickup-qty-input" type="number" min="0" id="pillowShamQty" name="pillowShamQty" value="0" />
            </div>
            <div class="col-md-6 col-lg-3">
                <label class="form-label" for="duvetCoverQty">Duvet Cover</label>
                <input class="form-control pickup-qty-input" type="number" min="0" id="duvetCoverQty" name="duvetCoverQty" value="0" />
            </div>
            <div class="col-md-6 col-lg-3">
                <label class="form-label" for="weightedBlanketQty">Weighted Blanket</label>
                <input class="form-control pickup-qty-input" type="number" min="0" id="weightedBlanketQty" name="weightedBlanketQty" value="0" />
            </div>
            <div class="col-md-6 col-lg-3">
                <label class="form-label" for="standardPillowQty">Standard Pillow</label>
                <input class="form-control pickup-qty-input" type="number" min="0" id="standardPillowQty" name="standardPillowQty" value="0" />
            </div>
            <div class="col-md-6 col-lg-3">
                <label class="form-label" for="mattressCoverQty">Mattress Cover</label>
                <input class="form-control pickup-qty-input" type="number" min="0" id="mattressCoverQty" name="mattressCoverQty" value="0" />
            </div>
        </div>

        <div class="form-check mt-4">
            <input class="form-check-input" type="checkbox" id="sameDayDelivery" name="sameDayDelivery" value="true" />
            <label class="form-check-label" for="sameDayDelivery">
                Same-day delivery
            </label>
        </div>

        <div class="alert alert-info mt-4 mb-0">
            <strong>Next step:</strong> you’ll pick your date/time and confirm address details on the schedule page.
        </div>

        <div class="d-flex gap-2 mt-4">
            <button class="btn btn-primary" type="submit">Continue to Schedule</button>
            <a class="btn btn-outline-secondary" href="/Home/Dashboard">Back</a>
        </div>
    </div>
</form>

<style>
    .schedule-hero {
        background: linear-gradient(135deg, #006994 0%, #0099b6 100%);
        border-radius: 14px;
        color: #fff;
        padding: 1.5rem;
    }

    .schedule-hero__inner h1 {
        font-size: 1.8rem;
        font-weight: 700;
    }

    .schedule-card {
        border: 1px solid #c8e6f5;
        border-radius: 14px;
        box-shadow: 0 10px 24px rgba(0, 105, 148, 0.08);
    }

    .pickup-qty-input {
        max-width: 140px;
    }

    @@media (max-width: 575.98px) {
        .pickup-qty-input {
            max-width: 100%;
        }
    }
</style>
